# Maintainer: Sigeon OS <https://github.com/SigeonOSDeveloper>
pkgname=sigeonos-keyring
pkgver=1.0.0
pkgrel=2
pkgdesc="Sigeon OS packager PGP keyring for pacman"
arch=('any')
url="https://github.com/SigeonOSDeveloper"
license=('GPL-3.0-or-later')
depends=('pacman')
source=(
  'sigeonos.gpg'
  'sigeonos-trusted'
  'sigeonos-keyring.hook'
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/sigeonos.gpg" "$pkgdir/usr/share/pacman/keyrings/sigeonos.gpg"
  install -Dm644 "$srcdir/sigeonos-trusted" "$pkgdir/usr/share/pacman/keyrings/sigeonos-trusted"
  install -Dm644 "$srcdir/sigeonos-keyring.hook" "$pkgdir/usr/share/libalpm/hooks/sigeonos-keyring.hook"
}
